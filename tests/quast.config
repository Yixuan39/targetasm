includeConfig '../conf/modules.config'

// The shared test config disables containers. These profiles turn one back on
// for the real QUAST process, which has to run the pinned image.
profiles {
    docker {
        docker.enabled = true
        process.resourceLimits = [cpus: 2, memory: 4.GB]
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        process.resourceLimits = [cpus: 2, memory: 4.GB]
    }
}
