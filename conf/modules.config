// Nextflow's publishDir `enabled:` is not evaluated as a closure (unlike `path:`), so it
// needs `params.keep_intermediates` to already be defined when this file is parsed on its
// own (e.g. nf-test's per-process `config '../conf/modules.config'`, which bypasses
// nextflow.config's `params {}` block entirely).
params.keep_intermediates = params.keep_intermediates ?: false

process {
    withName: METAMDBG_ASM {
        publishDir = [path: { "${params.outdir}/metaMDBG" }, mode: 'copy', pattern: '*.contigs.fasta.gz', enabled: params.keep_intermediates]
    }
    withName: MINIMAP2_ALIGN {
        ext.args  = '-x map-hifi --secondary=no'
        ext.args2 = '-n'
    }
    withName: SAMTOOLS_BAM2FQ {
        // samtools fastq defaults exclude 0x900; also exclude unmapped (0x4).
        ext.args   = '-n -F 0x904'
        publishDir = [path: { "${params.outdir}/minimap2" }, mode: 'copy', pattern: '*.fq.gz', enabled: params.keep_intermediates]
    }
    withName: RASUSA_READS {
        publishDir = [path: { "${params.outdir}/rasusa" }, mode: 'copy', pattern: '*.fastq.gz', enabled: params.keep_intermediates]
    }
    withName: HIFIASM {
        ext.args   = { "${params.hifiasm_option} --primary" }
        ext.prefix = { meta.id }
    }
    withName: GFATOOLS_GFA2FA {
        // Keep targetasm's existing version; the community module pins an older 0.5 build.
        container = 'quay.io/biocontainers/gfatools:0.5.5--h577a1d6_0'
        conda = "${projectDir}/conf/environments/gfatools.yml"
        publishDir = [path: { "${params.outdir}/hifiasm" }, mode: 'copy', pattern: '*.fasta.gz', enabled: params.keep_intermediates]
    }
    withName: '.*:FCS_INITIAL:(FCSGX_RUNGX|FCSGX_CLEANGENOME|HTSLIB_BGZIPTABIX)' {
        ext.prefix = { "${meta.id}.fcs_initial" }
    }
    withName: '.*:FCS_FINAL:(FCSGX_RUNGX|FCSGX_CLEANGENOME|HTSLIB_BGZIPTABIX)' {
        ext.prefix = { "${meta.id}.fcs_final" }
    }
    withName: FCSGX_RUNGX {
        publishDir = [path: { "${params.outdir}/fcs_gx" }, mode: 'copy', pattern: '*.fcs_gx_report.txt']
    }
    withName: '.*:FCS_INITIAL:HTSLIB_BGZIPTABIX' {
        publishDir = [path: { "${params.outdir}/fcs_gx" }, mode: 'copy', pattern: '*.fasta.gz', enabled: params.keep_intermediates]
    }
    withName: '.*:FCS_FINAL:HTSLIB_BGZIPTABIX' {
        publishDir = [path: { params.outdir }, mode: 'copy', pattern: '*.fasta.gz', saveAs: { _filename -> "${meta.id}.fasta.gz" }]
    }
    withName: COMPLEASM_RUN {
        // Compleasm updates library metadata; keep inputs immutable for safe caching and parallel QC.
        stageInMode = 'copy'
    }
    withName: QUAST {
        ext.args = '--eukaryote'
    }
    withName: MERGE_QUALITY_REPORTS {
        publishDir = [path: { "${params.outdir}/quality" }, mode: 'copy', pattern: 'quality_*.csv']
    }
}
