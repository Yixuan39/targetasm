process {
    shell  = ['/bin/bash', '-euo', 'pipefail']
    cpus   = 1
    memory = '4 GB'
    time   = { 4.h * task.attempt }

    // Retry once, with twice the time, after a scheduler kill (time limit, preemption, node failure).
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 1

    // Longest 0.1.0 tasks on the downy mildew isolates: metaMDBG 13 h, FCS-GX 4 h, minimap2 4 h, hifiasm 4 h.
    withLabel: process_single {
        cpus   = 1
        memory = '4 GB'
        time   = { 4.h * task.attempt }
    }
    withLabel: process_low {
        cpus   = { Math.min(4, params.threads as int) }
        memory = '8 GB'
        time   = { 8.h * task.attempt }
    }
    withLabel: 'process_medium|process_high' {
        cpus   = { params.threads as int }
        memory = { (params.threads as int) * 8.GB }
        time   = { 48.h * task.attempt }
    }
    withName: FCSGX_RUNGX {
        memory = '500 GB'
    }
}
