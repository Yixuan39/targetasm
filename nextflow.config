params {
    reads = null
    gx_db = null
    tax_id = null
    rasusa_bases = null
    outdir = 'results'
    threads = 24
    help = false
}

profiles {
    standard {
        process {
            executor = 'local'
            conda = 'environment.yml'
        }
    }
    slurm {
        conda.enabled = true  
        process {
            executor = 'slurm'
            conda = '${HOME}/miniforge3/envs/TEA' 
            useMamba = true
        }
    }
}
