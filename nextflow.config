manifest {
    name            = 'Yixuan39/targetasm'
    author          = 'Yixuan Yang'
    mainScript      = 'main.nf'
    homePage        = 'https://github.com/Yixuan39/targetasm'
    version         = '0.2.0'
    description     = 'Reference-independent assembly of target genomes from mixed long-read samples'
    nextflowVersion = '>=26.04.0'
}

plugins {
    id 'nf-schema@2.7.2'
}

validation.logging.unrecognisedParams = 'error'

params {
    reads              = null
    gx_db              = null
    tax_id             = null
    target_bases       = null
    rasusa_seed        = 0
    outdir             = '.'
    threads            = 24
    help               = false
    hifiasm_option     = '-l 2'
    keep_intermediates = false
    quality_library    = null
    quality_lineage    = ''
}


includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Short image names (the local Python reports) are hosted on Docker Hub.
docker.registry = 'docker.io'

profiles {
    standard {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
    }
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
    conda {
        conda.enabled = true
    }
    // Small functional run on a laptop; supply --reads and --gx_db (see docs/sc1982-smoke.md).
    test {
        params.tax_id         = 4762
        params.target_bases   = 100000000
        params.rasusa_seed    = 1982
        params.threads        = 4
        // -f 0 disables hifiasm's 16 GB Bloom filter so it fits the 6 GB limit.
        params.hifiasm_option = '-l 2 -f 0'
        process.resourceLimits = [cpus: 4, memory: 6.GB]
        executor.queueSize     = 1
        // Pipeline images are linux/amd64; this also lets them run on Apple Silicon.
        docker.runOptions      = '--platform linux/amd64'
    }
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.tsv"
    overwrite = true
}
