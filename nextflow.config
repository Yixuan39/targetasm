params {
    reads = null
    gx_db = null
    tax_id = null
    target_bases = null
    rasusa_seed = 42
    outdir = 'results'
    threads = 24
    help = false
    hifiasm_option = '-l 2'
    keep_intermediates = false
    quality_library = null
    quality_lineage = ''
}

profiles {
    standard {
        process {
            executor = 'local'
            conda = 'environment/TEA_main.yml'
            withName: 'fcs_gx_clean' {
                queue = 'bigmem,standard'
                memory = '500GB'
            }
            withName: quality_check {
                conda = 'environment/TEA_quality.yml'
            }
        }
        conda.useMamba = true
    }
    slurm {
        conda.enabled = true
        conda.useMamba = true
        process {
            executor = 'slurm'
            conda = '/home5/yyang55/miniforge3/envs/TEA'
            withName: 'fcs_gx_clean' {
                queue = 'bigmem,standard'
                cpus = 24
                memory = '500GB'
            }
            withName: quality_check {
                conda = '/home5/yyang55/miniforge3/envs/TEA_quality'
            }
        }
    }
}
